# sdkconfig.defaults — persisted Kconfig overrides shared by every supported
# ESP32-S3-DevKitC-1 board variant. PSRAM bus mode (Quad/Octal) and flash
# size are board-specific and NOT set here — scripts/detect_board.py detects
# the connected board at build time and generates sdkconfig.defaults.detected
# (picking sdkconfig.defaults.quad or sdkconfig.defaults.oct) to cover those.

# ---- PSRAM (settings common to both Quad and Octal modes) ----
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- Flash ----
CONFIG_PARTITION_TABLE_CUSTOM=n
CONFIG_PARTITION_TABLE_TWO_OTA=n
CONFIG_PARTITION_TABLE_SINGLE_APP=n

# ---- OTA ----
# A web-uploaded image that crashes before app_main finishes startup never
# calls esp_ota_mark_app_valid_cancel_rollback(), so the bootloader falls
# back to the previous working firmware on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- FreeRTOS ----
# Larger default stack so we don't have to tune every task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# ---- WiFi ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER=DYNAMIC
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# ---- WiFi roaming (mesh AP hand-off) ----
# ESP-IDF's station driver has no built-in roaming: once associated to an AP
# it stays there until a hard disconnect (deauth/beacon-loss timeout), even
# if a much stronger AP of the same SSID is sitting right next to it. On a
# multi-AP mesh (e.g. UniFi) that's a real failure mode — a unit can land on
# a far/weak AP at boot and then get stuck there indefinitely with no
# self-recovery, looking "connected" (LED and all) while barely passing any
# traffic. Confirmed live on the .122 field unit: it associated to an AP at
# -75dBm while a -42dBm AP of the same network was available, and never
# generated a single WIFI_EVENT_STA_DISCONNECTED while reachability collapsed.
# Espressif's own roaming app (in-tree, Kconfig-gated as "experimental")
# fixes this: it monitors RSSI/periodically scans and forces a reassociation
# to a meaningfully stronger AP of the same network, using 802.11v BTM where
# the AP supports it and falling back to a plain disconnect+reconnect
# otherwise. Needs no application code — see esp_wifi/wifi_apps/roaming_app.
# Everything below CONFIG_ESP_WIFI_ENABLE_ROAMING_APP is left at Espressif's
# own defaults (Kconfig.roaming) except:
# - The low-RSSI trigger itself: the stock -60dBm was roaming too eagerly (a
#   roam briefly interrupts any active RTSP stream, so it shouldn't fire over
#   a merely mediocre-but-fine link) — raised to -75dBm at the Kconfig level
#   (the actual live value is app_config.h's roaming_rssi_threshold_dbm,
#   user-adjustable in the web UI's WiFi card; this is only the boot-time
#   seed before that's ever been saved to NVS — see
#   wifi_manager_apply_roaming_rssi()).
# - The periodic scan monitor: a *second*, independent trigger that ran on
#   its own -50dBm/30s schedule regardless of the low-RSSI setting above —
#   disabled entirely so the low-RSSI trigger is the only thing that can
#   ever start a roam. Note this changes the real `struct roam_config`
#   layout (scan_interval/scan_rssi_threshold/scan_rssi_diff only exist
#   when this is on) — wifi_manager.c's mirrored copy of that struct must
#   be kept in sync with this setting, or roam_get/set_config_params()
#   silently misaligns every field after it.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_ENABLE_ROAMING_APP=y
CONFIG_ESP_WIFI_ROAMING_LOW_RSSI_THRESHOLD=-75
CONFIG_ESP_WIFI_ROAMING_PERIODIC_SCAN_MONITOR=n

# ---- Compiler ----
# Disable -Werror so C++ flags passed to C files don't break the build
CONFIG_COMPILER_WARNINGS_EXTRA=n

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- LWIP sockets ----
# Default (10) is sized as if the web server were the only socket user —
# esp_http_server's own default config (max_open_sockets=7, +3 reserved
# internally) alone consumes the entire default budget, leaving nothing
# for the RTSP listener/clients, mDNS, or the OTA HTTPS client. Raised to
# fit all of them; web_server.c caps httpd's own share (max_open_sockets)
# so it can't reclaim the room this makes for everything else.
CONFIG_LWIP_MAX_SOCKETS=16

# ---- USB Host (UAC microphone) ----
# Default (256B) is too small for UAC mics whose configuration descriptor
# covers multiple interfaces/alt settings; enumeration fails with
# "Configuration descriptor larger than control transfer max length".
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

# Default (4) truncates a UAC mic's discrete sample-rate list to the first 4
# entries in descriptor order, silently dropping the rest. The TONOR TC30
# (0d8c:0134) advertises 7 rates (8000/11025/16000/22050/32000/44100/48000);
# with the default limit only the first 4 survive, so both the 44.1kHz and
# 48kHz web UI options failed with ESP_ERR_NOT_SUPPORTED. Raised to fit the
# full 6-option range this project's web UI offers (web_server.c), plus
# headroom for other mics.
CONFIG_UAC_FREQ_NUM_MAX=8
